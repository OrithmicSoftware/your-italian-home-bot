# Telegram bot token
BOT_TOKEN=your_bot_token_here
# Admin chat ID (who gets notified)
ADMIN_CHAT_ID=123456789
# Agent chat ID (who receives forwarded requests)
AGENT_CHAT_ID=987654321
# Agent forwarding mode: 'no', 'all', or 'ask'
#   no  - never forward to agent
#   all - always forward to agent
#   ask - prompt user before forwarding
FORWARD_TO_AGENT=ask
